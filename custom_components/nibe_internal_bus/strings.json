      "user": {
        "title": "Connect to nibegw",
        "description": "Enter the address of the ESP32 running the esphome-nibe `nibegw` component \u2014 not the heat pump itself. Home Assistant registers itself as a UDP forwarding target and only listens; it never writes to the RS-485 bus.",
        "data": {
          "host": "Host",
          "port": "Port"
        },
        "data_description": {
          "host": "IP address or hostname of the ESP32 running esphome-nibe.",
          "port": "The nibegw `read_port`, 9999 unless you changed it."
        }
      }
    },
    "error": {
      "cannot_connect": "No data arrived from that address. Check the IP and port, and that the device is on the same network.",
